\ProvidesPackage{accosuthesis}[2026/08/28 v1.0.0 Style for Ohio State University dissertations and theses]
\RequirePackage{unicode-math}
\RequirePackage{microtype}
\RequirePackage{booktabs}
\RequirePackage[letterpaper,includeheadfoot,top=1.0in,bottom=1.0in,right=1.0in,left=1.5in]{geometry}
\RequirePackage[doublespacing]{setspace} % `doublespacing' is actually about 1.6 spacing, which is better anyway
\RequirePackage{graphicx}
\RequirePackage{fancyhdr}
\RequirePackage[table,x11names]{xcolor}
\definecolor{linkblue}{rgb}{0,0,0.30}
\RequirePackage{url}
\RequirePackage[pdfborder={0 0 0}, colorlinks=true, citecolor=linkblue, linkcolor=linkblue, urlcolor=linkblue, bookmarksopen=true, bookmarksopenlevel=1]{hyperref}
\RequirePackage{bookmark}

\pagestyle{plain}


%%% Change this to increase Table of Contents depth, beyond just chapters and sections
\setcounter{tocdepth}{2}
\renewcommand\contentsname{\normalsize {\normalfont Table of Contents}}


%%% Iinitial definitions
\def\degree#1{\gdef\@degree{#1}}
\def\papertype#1{\gdef\@papertype{#1}}
\def\dept#1{\gdef\@dept{#1}}
\def\subject#1{\gdef\@subject{#1}}
\def\keywords#1{\gdef\@keywords{#1}}
\def\committeechair#1{\gdef\@committeechair{#1}}
\def\committeemembera#1{\gdef\@committeemembera{#1}}
\def\committeememberb#1{\gdef\@committeememberb{#1}}
\def\committeememberc#1{\gdef\@committeememberc{#1}}
\def\committeememberd#1{\gdef\@committeememberd{#1}}
%% \long\def allows for multiple paragraphs
\long\def\abstract#1{\gdef\@abstract{#1}}
\long\def\ack#1{\gdef\@ack{#1}}
\long\def\dedication#1{\gdef\@dedication{#1}}
\long\def\vita#1{\gdef\@vita{#1}}
\long\def\publications#1{\gdef\@publications{#1}}
\long\def\studyfields#1{\gdef\@studyfields{#1}}
\renewcommand\bibname{References}


%%% Heading formatting for Tagged PDF (LaTeX-lab template system)
\IfInstanceExistsT{heading}{chapter}{
  \DeclareInstance{headformat}{chapter}{display}
  {
    , heading-indent    = 0pt
    , prefix-number-sep = \WordSpaceAmount{1}
    , number-title-sep  = 2em
  }

  \DeclareInstance{heading}{chapter}{display}
  {
    , name           = chapter
    , level          = 0
    , placement      = top
    , after-penalty-vspace = 0pt
    , after-vspace   = 40pt
    , prefix         = \@chapapp
    , number-format  = \thechapter
    , heading-decls  = \centering\normalfont
    , title-decls    = \bfseries\Large
    , headformat-instance = chapter
    , mark-cmd       = \chaptermark {#1}
    , contents-extra = \addtocontents{lof}{\protect\addvspace{10\p@}}
                       \addtocontents{lot}{\protect\addvspace{10\p@}}
  }
}

\IfInstanceExistsT{heading}{section}{
  \DeclareInstance{heading}{section}{display}
  {
    , name          = section
    , level         = 1
    , mark-cmd      = \sectionmark {#1}
    , before-vspace = 3.5ex plus 1ex minus .2ex
    , after-vspace  = 2.3ex plus .2ex
    , heading-decls = \normalfont\Large\bfseries
    , headformat-instance = section
  }
}

%%% The following fallback commands are for legacy / non-tagged compilation
\def\@makechapterhead#1{%
  \vspace*{0\p@}%
  {\parindent \z@ \raggedright \normalfont
    \begin{center}
    \ifnum \c@secnumdepth >\m@ne
      \if@mainmatter
        \@chapapp\space \thechapter
        \par
        \vspace{2em}
      \fi
    \fi
    \interlinepenalty\@M
	{\bfseries\Large#1}\par\nobreak
    \vskip 40\p@
    \end{center}
  }}

\def\@makeschapterhead#1{%
  \vspace*{-20\p@}%
  {\parindent \z@ \raggedright \normalfont
    \begin{center}
    \ifnum \c@secnumdepth >\m@ne
      \if@mainmatter
        \par
        \vspace{2em}
      \fi
    \fi
    \interlinepenalty\@M
	{\bfseries\Large#1}\par\nobreak
    \vskip 40\p@
    \end{center}
  }}

%%% Change TOC header
\renewcommand\tableofcontents{%
    \begin{spacing}{1.0}
    \if@twocolumn
      \@restonecoltrue\onecolumn
    \else
      \@restonecolfalse
    \fi
    \chapter*{
        \vspace*{0.1in}
        \begin{center}
        \normalsize \contentsname
        \end{center}
        \@mkboth{%
           \contentsname}{\contentsname}}%
    \@starttoc{toc}%
    \if@restonecol\twocolumn\fi
    \end{spacing}
    \clearpage
}

%%% Use standard dotted TOC line for chapters to maintain tagged PDF/UA compliance
\renewcommand*\l@chapter{\@dottedtocline{0}{0pt}{1.5em}}

%
%%
%%% The previous commands were modified from book.cls

%%% Specify Front Matter
\renewcommand{\frontmatter}{
    \pagenumbering{roman}
    \titlepage
    \copyrightpage
    \abstractpage
    %\dedicationpage
    \ackpage
    \vitapage
    \tableofcontents
    \clearpage
    \phantomsection
    \addcontentsline{toc}{chapter}{List of Figures}
    \listoffigures
    %\rule{2in}{1pt}
    \clearpage
    \phantomsection
    \addcontentsline{toc}{chapter}{List of Tables}
    \listoftables
    \clearpage
    \pagenumbering{arabic}
}

%%% Set orphan and widow penalties really high
\brokenpenalty=9999
\clubpenalty=9999
\widowpenalty=9999


%%% Title page
\renewcommand{\titlepage}{
\hypersetup{pdfauthor={\@author}, pdftitle={\@title}, pdfsubject={\@subject}, pdfkeywords={\@keywords}} % Populates PDF metadata with info that the user has already supplied
 \thispagestyle{empty}

    \vspace*{0.0in}
    \begin{center}

    \@title

    \vspace{0.65in}

    \@papertype

    \vspace{0.5in}

    Presented in Partial Fulfillment of the Requirements for the Degree

    \@degree

    in the Graduate School of The Ohio State University

    \vspace{0.45in}

    By

    \@author

    \vspace{1.4em}

    %%% Separator (tagged as Artifact for assistive technologies)
    \tagstructbegin{tag=Artifact}%
    \tagmcbegin{tag=Artifact}%
    \makebox[12mm][c]{%
      \resizebox{12mm}{\height}{$\sim$}%
      \hspace{-12mm}%
      \makebox[12mm][c]{$\scriptstyle /\mkern-5.5mu/$}%
    }%
    \tagmcend%
    \tagstructend%

    \vspace{2.3em}

    Graduate Program in \@dept

    The Ohio State University

    \number\year


    \vspace{2.3em}


  \@papertype \ Committee:

  Professor \@committeechair , Advisor

  Professor \@committeemembera

  Professor \@committeememberb

  %Professor \@committeememberc

  %Professor \@committeememberd

  % To put multiple committee members on the same line for big committees:
  %Professor \@committeemembera \qquad Professor \@committeememberb
    
  %Professor \@committeememberc \qquad Professor \@committeememberd

  \end{center}
  \clearpage
}
%%% End Title page


%%% Copyright page
\newcommand{\copyrightpage}{
    \thispagestyle{empty}
    \vspace*{2.5in}
    \begin{center}
    \copyright{} \@author, \number\year
    \end{center}
    \clearpage
}


%%% Abstract page
\newcommand{\abstractpage}{
    \phantomsection
    \addcontentsline{toc}{chapter}{Abstract}
    \vspace*{0.0in}

    \begin{center}
    Abstract
    \end{center}

    \vspace{3em}
    \@abstract
    \clearpage
}


%%% Acknowledgments page
% The extra 'e' is optional in English
\newcommand{\ackpage}{
    \phantomsection
    \addcontentsline{toc}{chapter}{Acknowledgements}
    \vspace*{0.0in}
    \begin{center}
    Acknowledgements
    \end{center}
    \vspace{3em}
    \@ack
    \clearpage
}


%%% Vita page
\newcommand{\vitapage}{
    \phantomsection
    \addcontentsline{toc}{chapter}{Vita}
    \vspace*{0.0in}
    \begin{center}
    Vita
    \end{center}
    \vspace{2em}
    \@vita

    \vspace{2em}

    \begin{center}
    Publications
    \end{center}
    \vspace{2em}
    \@publications

    \vspace{2em}

    \begin{center}
    Fields of Study
    \end{center}
    \vspace{2em}
    \@studyfields

    \clearpage
}

